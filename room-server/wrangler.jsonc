{
  // Settings for the room server (a Cloudflare Worker).
  "name": "vini-room",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "routes": [{ "pattern": "room.vini.games", "custom_domain": true }]
}
